# {{ ansible_managed }}
ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_controller_host }}
SlurmUser=slurm
AuthType=auth/munge
MpiDefault=none
ReturnToService=2

SlurmctldPidFile=/var/run/slurmctld.pid
SlurmdPidFile=/var/run/slurmd.pid
SlurmdSpoolDir=/var/spool/slurmd
StateSaveLocation=/var/spool/slurmctld
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdLogFile=/var/log/slurm/slurmd.log
SlurmctldTimeout=120
SlurmdTimeout=300

# Resource enforcement
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory

# Scheduling: backfill plus multifactor priority (fair-share, age, QoS)
SchedulerType=sched/backfill
PriorityType=priority/multifactor
PriorityDecayHalfLife={{ slurm_priority_decay_half_life }}
PriorityWeightFairshare={{ slurm_priority_weight_fairshare }}
PriorityWeightAge={{ slurm_priority_weight_age }}
PriorityWeightQOS={{ slurm_priority_weight_qos }}

# Accounting
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ slurm_controller_host }}
AccountingStorageEnforce=associations,limits,qos
{% if slurm_gpu_count | int > 0 %}
AccountingStorageTRES=gres/gpu
{% endif %}
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=30

{% if slurm_gpu_count | int > 0 %}
GresTypes=gpu
{% endif %}

# Compute nodes
{% for n in groups['slurm_compute'] %}
NodeName={{ n }} CPUs={{ slurm_node_cpus }} RealMemory={{ slurm_node_memory_mb }}{% if slurm_gpu_count | int > 0 %} Gres=gpu:{{ slurm_gpu_count }}{% endif %} State=UNKNOWN
{% endfor %}

# Partitions
{% for p in slurm_partitions %}
PartitionName={{ p.name }} Nodes={{ p.nodes | default('ALL') }} Default={{ 'YES' if p.default | default(false) else 'NO' }} MaxTime={{ p.max_time | default('INFINITE') }} State=UP
{% endfor %}
